# =====================================================================
# Pizza Demo Auditor — variables de entorno
# Copiar este archivo a `.env.local` y completar los valores reales.
# `.env.local` está en .gitignore — NO se commitea.
# =====================================================================

# Connection string a la Supabase de Pizza Demo, usando el rol READ-ONLY.
#
# IMPORTANTE: NUNCA usar la SERVICE_ROLE_KEY ni el rol `postgres` del proyecto.
# El MCP debe correr con un rol custom limitado a SELECT.
#
# Crear el rol UNA sola vez en el SQL editor de Supabase (proyecto Pizza Demo):
#
#   CREATE ROLE mcp_auditor LOGIN PASSWORD '<password-fuerte-random>';
#   GRANT USAGE ON SCHEMA public TO mcp_auditor;
#   GRANT SELECT ON orders, order_items, order_tokens, order_status_events,
#                    customers, addresses, products, product_sizes, settings
#     TO mcp_auditor;
#   REVOKE ALL ON profiles FROM mcp_auditor;  -- staff data, no la necesita
#
# Formato del connection string:
#   postgres://mcp_auditor:<password>@<proyecto>.supabase.co:5432/postgres?sslmode=require
#
DATABASE_URL=

# Nivel de logs por stderr (info | warn | error | debug). Default: info.
LOG_LEVEL=info
